  "nodes": [
    {
      "id": "gitnexus-framework",
      "label": "GitNexus Code Intelligence Framework",
      "kind": "system",
      "category": "tool",
      "description": "Code intelligence tool for understanding code, assessing impact, and navigating safely. Tracks symbols, relationships, and execution flows in the workshop-site project.",
      "metadata": {
        "projectIndexed": "workshop-site",
        "symbolCount": 2959,
        "relationshipCount": 4550,
        "executionFlowCount": 123
      }
    },
    {
      "id": "workshop-site-project",
      "label": "workshop-site Project",
      "kind": "project",
      "category": "project",
      "description": "Next.js web application indexed by GitNexus with 2959 symbols and 4550 relationships"
    },
    {
      "id": "gitnexus-impact-analysis",
      "label": "gitnexus_impact Tool",
      "kind": "tool",
      "category": "analysis",
      "description": "Analyzes blast radius of code changes before editing. Reports direct callers, affected processes, and risk levels.",
      "metadata": {
        "required": true,
        "usage": "gitnexus_impact({target: 'symbolName', direction: 'upstream'})"
      }
    },
    {
      "id": "gitnexus-detect-changes",
      "label": "gitnexus_detect_changes Tool",
      "kind": "tool",
      "category": "analysis",
      "description": "Verifies that changes only affect expected symbols and execution flows. Must run before committing.",
      "metadata": {
        "required": true,
        "stage": "pre-commit"
      }
    },
    {
      "id": "gitnexus-query",
      "label": "gitnexus_query Tool",
      "kind": "tool",
      "category": "search",
      "description": "Queries code execution flows instead of grepping. Returns process-grouped results ranked by relevance.",
      "metadata": {
        "usage": "gitnexus_query({query: 'concept'})",
        "purpose": "find-execution-flows"
      }
    },
    {
      "id": "gitnexus-context",
      "label": "gitnexus_context Tool",
      "kind": "tool",
      "category": "inspection",
      "description": "Gets full context on a specific symbol including callers, callees, and execution flows.",
      "metadata": {
        "usage": "gitnexus_context({name: 'symbolName'})"
      }
    },
    {
      "id": "gitnexus-rename",
      "label": "gitnexus_rename Tool",
      "kind": "tool",
      "category": "refactoring",
      "description": "Safely renames symbols while understanding the call graph. Must be used instead of find-and-replace.",
      "metadata": {
        "required": true,
        "constraint": "call-graph-aware"
      }
    },
    {
      "id": "code-editing-best-practices",
      "label": "Code Editing Best Practices",
      "kind": "process",
      "category": "workflow",
      "description": "Enforced workflow for safe code modifications in workshop-site project"
    },
    {
      "id": "impact-analysis-gate",
      "label": "Impact Analysis Gate",
      "kind": "constraint",
      "category": "safety",
      "description": "Mandatory impact analysis before editing functions, classes, or methods. Warns on HIGH or CRITICAL risk.",
      "metadata": {
        "enforcementLevel": "MUST",
        "riskThreshold": "HIGH"
      }
    },
    {
      "id": "change-detection-gate",
      "label": "Change Detection Gate",
      "kind": "constraint",
      "category": "safety",
      "description": "Mandatory change detection before committing to verify scope is as expected",
      "metadata": {
        "enforcementLevel": "MUST",
        "stage": "pre-commit"
      }
    },
