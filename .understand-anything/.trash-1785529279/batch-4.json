      "id": "database-table:email_suppressions",
      "type": "database-table",
      "label": "email_suppressions",
      "description": "Global marketing email suppression list for RFC 8058 one-click unsubscribe",
      "properties": {
        "schema": "public",
        "columns": [
          {
            "name": "email",
            "type": "text",
            "constraints": "primary key"
          },
          {
            "name": "reason",
            "type": "text",
            "constraints": "not null",
            "default": "'unsubscribed'"
          },
          {
            "name": "source",
            "type": "text",
            "constraints": "nullable"
          },
          {
            "name": "created_at",
            "type": "timestamptz",
            "constraints": "not null",
            "default": "now()"
          }
        ],
        "indexes": [
          "email_suppressions_created_at_idx"
        ],
        "rls": "enabled",
        "rls_policies": "no anon/authenticated policies"
      }
    },
    {
      "id": "database-index:email_suppressions_created_at_idx",
      "type": "database-index",
