# Copy to .env.local and fill in real values. Never commit .env.local.

MANDRILL_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
EVENTSCHEDULE_BASE_URL=
EVENTSCHEDULE_ADMIN_EMAIL=
EVENTSCHEDULE_ADMIN_PASSWORD=

CRON_SECRET=

# HMAC signing secret for RFC 8058 one-click unsubscribe tokens
# (src/lib/list-unsubscribe.ts). Any long random string. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates every unsubscribe link already sent (recipients
# would need to unsubscribe again), so set it once and leave it alone.
UNSUBSCRIBE_TOKEN_SECRET=

# The AI Agent Income Playbook (live mode, added 2026-07-08)
AI_AGENT_INCOME_STRIPE_SECRET_KEY=
AI_AGENT_INCOME_SETUP_PRICE_ID=
AI_AGENT_INCOME_MONTHLY_PRICE_ID=
AI_AGENT_INCOME_STRIPE_WEBHOOK_SECRET=
ILLY_GUIDE_PASSWORD=
