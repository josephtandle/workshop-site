{
  "schema": "mnstry.atelier-boundary-policy@v1",
  "mode": "strict",
  "actors": {
    "joe": {
      "githubLogin": "JOE_GITHUB_LOGIN_PLACEHOLDER",
      "gitEmails": [
        "joe@example.invalid"
      ],
      "privateDomainRepo": "workshop-site"
    }
  },
  "repos": {
    "workshop-site": {
      "kind": "private_domain",
      "ownerActor": "joe",
      "readBoundary": "team",
      "allowedAudiences": [
        "private",
        "sensitive",
        "team",
        "operator",
        "staff",
        "public"
      ],
      "forbiddenAudiences": [],
      "autoCommit": "guarded"
    }
  },
  "promotion": {
    "requiresGitPromote": true,
    "recordsPath": "governance/git-promote-events.jsonl"
  },
  "forbiddenPaths": [
    ".atelier-local/**",
    "atelier.local.json",
    "atelier.workspace.local.json",
    "atelier-attestation-key.local.json",
    ".mnstry-local/**",
    ".atelier-proposals/**",
    "support-bundles/**",
    "prompts/**",
    "transcripts/**"
  ],
  "governanceLedgerPath": "governance/repo-boundary-ledger.md"
}
