{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "decks.mastermindshq.business"
        }
      ],
      "destination": "/2x-with-ai-playbook.html"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "passiveincome.mastermindshq.business"
        }
      ],
      "destination": "/ai-agent-income"
    }
  ],
  "crons": [
    {
      "path": "/api/events/abandoned-checkout-followups",
      "schedule": "15 1 * * *"
    },
    {
      "path": "/api/events/abandoned-checkout-followups-t12h",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/events/location-reminders",
      "schedule": "30 23 29 5 *"
    },
    {
      "path": "/api/events/session-reminders",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/events/reconcile-registrations",
      "schedule": "0 20 * * *"
    }
  ]
}
